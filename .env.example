NATS_URL=nats://nats:4222
POSTGRES_DSN=postgres://qc:qc@postgres:5432/qc?sslmode=disable

# Used only by checker-ai-visual. Choose: codex-api, codex-cli,
# claude-code-api, or claude-code-cli.
AI_QC_AGENT=codex-cli

# Required only for the corresponding API agent. Keep real keys in your
# uncommitted .env file.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional model override. Leave blank to use the API agent's default or the
# selected CLI's configured default model.
AI_QC_MODEL=

# Required only for the corresponding CLI agent. Use absolute host paths.
CODEX_AUTH_DIR=
CLAUDE_AUTH_DIR=
AI_QC_TIMEOUT_SEC=90
